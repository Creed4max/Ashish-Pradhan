rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || resource == null);
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Subjects collection
    match /subjects/{subjectId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Notes collection
    match /notes/{noteId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Timetable collection
    match /timetable/{slotId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Fallback for tests & healthchecks
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
